[build-system]
requires = ["setuptools>=62", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "land-scout-lite"
version = "0.1.0"
description = "Fast, repeatable land-deal scouting with simple heuristics"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "pandas>=2.1",
    "pyyaml>=6.0",
    "tabulate>=0.9"
]

[project.optional-dependencies]
dev = [
    "pytest>=7",
    "ruff>=0.5.0",
    "black>=24.3.0",
    "isort>=5.13.0",
    "pre-commit>=3.7"
]

[project.scripts]
land-scout = "land_scout.cli:main"

[tool.setuptools]
include-package-data = false

[tool.setuptools.packages.find]
where = ["."]
include = ["land_scout*"]
exclude = ["tests*", "src*"]
